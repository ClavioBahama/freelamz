# Modelo para o botão "Add from .env" da Render (Environment Variables).
# NÃO contém valores reais — preencha localmente e cole no painel da Render.
# O backend/.env local NÃO deve ser enviado: contém DB_HOST/DB_PASSWORD de desenvolvimento.
MYSQL_URL=mysql://<UTILIZADOR_TIDB>:<SENHA_TIDB>@gateway01.sa-east-1.prod.aws.tidbcloud.com:4000/freelamz
DB_SSL=true
JWT_SECRET=<GERAR_LOCALMENTE_COM_NODE_CRYPTO>
NODE_ENV=production
CORS_ORIGINS=http://localhost,https://localhost,capacitor://localhost
SEED_DEMO=true
