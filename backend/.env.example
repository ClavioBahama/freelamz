# ============================================================
# FreelaMZ — Backend (.env.example)
# Copie para .env e ajuste. NUNCA envie o .env para o GitHub.
# Em produção (Railway) estas variáveis vão no painel do serviço.
# ============================================================

# ---------- NO RAILWAY (mínimo para o serviço backend) ----------
# MYSQL_URL=${{MySQL.MYSQL_URL}}   # cobre host, porta, utilizador, senha e base
# JWT_SECRET=<valor aleatório>     # node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# NODE_ENV=production
# CORS_ORIGINS=http://localhost,https://localhost,capacitor://localhost
# ADMIN_EMAIL=<o-teu-email>        # usado apenas por: npm run db:init
# ADMIN_PASSWORD=<senha-forte>     # usado apenas por: npm run db:init
# UPLOADS_DIR=/app/uploads         # apenas se montar um Volume

# ---------- Servidor ----------
# PORT é definida automaticamente pelo Railway; localmente usa 3000.
PORT=3000
# development | production
NODE_ENV=development
APP_URL=http://localhost:3000

# ---------- CORS ----------
# Lista separada por vírgulas das origens do navegador.
# As origens do APK (capacitor://localhost, http://localhost,
# https://localhost) já são aceites automaticamente pelo código.
# Exemplo em produção: https://freelamz.com,https://www.freelamz.com
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost,https://localhost,capacitor://localhost

# Compatibilidade: usada apenas se CORS_ORIGINS não existir.
FRONTEND_URL=http://localhost:5173

# ---------- Base de dados MySQL ----------
# Opção 1 (recomendada no Railway): uma única string de ligação.
# MYSQL_URL=mysql://user:password@host:porta/nome_da_base
#
# Opção 2: variáveis separadas.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=freelamz

# No Railway também funciona sem definir nada disto: o código lê
# automaticamente MYSQLHOST, MYSQLPORT, MYSQLUSER, MYSQLPASSWORD
# e MYSQLDATABASE (ou MYSQL_URL) quando disponíveis.

# SSL (MySQL gerido na nuvem). true = liga encriptação.
DB_SSL=false
# Caminho para o certificado da AC (opcional; valida o certificado).
# DB_SSL_CA=/caminho/para/ca.pem

# ---------- Autenticação (JWT) ----------
# Gere um valor aleatório longo. NUNCA reutilize o exemplo.
JWT_SECRET=troque_por_um_valor_aleatorio_longo_e_secreto
JWT_EXPIRES_IN=7d

# ---------- Administrador (npm run db:init) ----------
# Obrigatórios para criar o admin. Sem valores por omissão em produção.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---------- Uploads ----------
# Pasta pública dos ficheiros (/uploads).
# Local: por omissão backend/uploads (pode deixar vazio).
# Railway com Volume montado: UPLOADS_DIR=/app/uploads
UPLOADS_DIR=
# Pasta privada das entregas (por omissão: irmã de UPLOADS_DIR).
# Railway: UPLOADS_PRIVATE_DIR=/app/uploads_private
UPLOADS_PRIVATE_DIR=
# Tamanho máximo por imagem em bytes (5 MB).
MAX_FILE_SIZE=5242880

# ---------- Pagamentos ----------
# PAYMENT_PROVIDER: fake (modo de teste) | mpesa | emola
# - fake: carteira simulada, M-Pesa/e-Mola/cartão fictícios
# - mpesa/emola: exigem as chaves abaixo
PAYMENT_PROVIDER=fake
FAKE_PAYMENT_DELAY_MS=1500
FAKE_PAYMENT_FAIL_RATE=0
MPESA_API_KEY=
MPESA_API_SECRET=
EMOLA_API_KEY=
EMOLA_API_SECRET=
