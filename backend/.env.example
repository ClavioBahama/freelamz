# Configuração do servidor
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000

# Origens permitidas no CORS (separadas por vírgula).
# Inclua o site e, se usar o APK, as origens do Capacitor.
# Exemplo de produção: https://freelamz.com,https://www.freelamz.com
CORS_ORIGINS=http://localhost:5173,http://localhost,https://localhost,capacitor://localhost

# Compatibilidade: usada se CORS_ORIGINS não estiver definida
FRONTEND_URL=http://localhost:5173

# Banco de dados MySQL (Laragon / servidor)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=freelamz
# SSL opcional (MySQL gerido na nuvem): true ou false
DB_SSL=false
# Caminho para o certificado da AC (opcional; valida o certificado)
# DB_SSL_CA=/caminho/para/ca.pem

# JWT (troque estes valores em produção!)
JWT_SECRET=sua_chave_secreta_muito_longa_e_segura_aqui
JWT_EXPIRES_IN=7d

# Uploads
MAX_FILE_SIZE=5242880
UPLOAD_DIR=uploads

# Pagamentos (FASE A)
# PAYMENT_PROVIDER: fake (modo de teste) | mpesa | emola
# - fake: carteira simulada, M-Pesa/e-Mola/cartão fictícios, banner "MODO DE TESTE"
# - mpesa/emola: exigem as chaves abaixo (esqueletos prontos, cobrança externa)
PAYMENT_PROVIDER=fake
FAKE_PAYMENT_DELAY_MS=1500   # atraso simulado das cobranças externas (M-Pesa/e-Mola/cartão)
FAKE_PAYMENT_FAIL_RATE=0     # 0 a 1 — probabilidade de falha simulada (só em dev)
MPESA_API_KEY=
MPESA_API_SECRET=
EMOLA_API_KEY=
EMOLA_API_SECRET=